{
    "openapi": "3.0.0",
    "info": {
        "title": "Zowe API-ML Token Delegation Service",
        "version": "1.0.0",
        "description": "API for delegating credentials to generate a z/OS PassTicket based on an existing authenticated JWT (Bearer) token."
    },
    "servers": [
        {
            "url": "https://{hostname}/api/v1",
            "variables": {
                "hostname": {
                    "default": "zowe-apiml-gateway",
                    "description": "The host name of the Zowe API Mediation Layer gateway."
                }
            }
        }
    ],
    "paths": {
        "/auth/delegations/passticket": {
            "post": {
                "tags": [
                    "Authentication and Delegation"
                ],
                "summary": "Generate a one-time PassTicket for a z/OS application.",
                "operationId": "generatePassTicket",
                "description": "The authenticated service uses this endpoint to request a PassTicket for a target user (identified by emailId) for a specific z/OS application (applid). The incoming Bearer token is validated to ensure the requester is authorized to perform delegation before the ticket is generated.",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "description": "Delegation request details",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PassTicketRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "PassTicket successfully generated.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PassTicketResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request (e.g., missing required body fields like emailId or applid).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Missing required parameter: emailId."
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized (Invalid or expired Bearer Token). This indicates the token validation failed.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "JWT validation failed or token is expired/invalid."
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden (Authenticated but not authorized to perform delegation).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Service is not authorized to request PassTicket delegation."
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "description": "Requires a valid Zowe authorization JWT provided in the 'Authorization: Bearer <token>' header. This token is validated for structure, expiration, and necessary delegation permissions."
            }
        },
        "schemas": {
            "PassTicketRequest": {
                "type": "object",
                "required": [
                    "emailId",
                    "applid"
                ],
                "properties": {
                    "emailId": {
                        "type": "string",
                        "format": "email",
                        "description": "The email ID of the user for whom the PassTicket should be generated (used for z/OS ID mapping).",
                        "example": "john.doe@company.com"
                    },
                    "applid": {
                        "type": "string",
                        "description": "The Application ID (APPLID) of the target z/OS application that will validate the PassTicket.",
                        "example": "TSO"
                    }
                }
            },
            "PassTicketResponse": {
                "type": "object",
                "properties": {
                    "passticket": {
                        "type": "string",
                        "description": "The generated, one-time-use, time-sensitive PassTicket string.",
                        "example": "01A2B3C4D5E6F789"
                    },
                    "tsoUserid": {
                        "type": "string",
                        "description": "The z/OS TSO User ID derived from the input emailId mapping, used to validate the PassTicket.",
                        "example": "JDOE01"
                    },
                    "expiration": {
                        "type": "string",
                        "format": "date-time",
                        "description": "The calculated time the PassTicket will expire (typically 1-10 minutes from generation)."
                    }
                }
            }
        }
    }
}