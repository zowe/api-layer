<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property resource="application.yml"/>
    <property name="MAX_INDEX" value="${rollingPolicy.maxIndex:-12}"/>
    <property name="MIN_INDEX" value="${rollingPolicy.minIndex:-1}"/>
    <property name="MAX_FILE_SIZE" value="${rollingPolicy.file.maxSize:-50MB}"/>
    <property name="STORAGE_LOCATION" value="${apiml.logs.location}"/>

    <springProperty scope="context"
                    name="LOG_TO_FILE"
                    source="apiml.logging.toFile.enabled"
                    defaultValue="false"/>

    <springProperty scope="context"
                    name="DEBUG_ONLY_TO_FILE"
                    source="apiml.logging.toFile.debugOnly"
                    defaultValue="false"/>

    <springProperty scope="context"
                    name="APIML_LOG_PATTERN"
                    source="logging.pattern"
                    defaultValue="%d{yyyy-MM-dd HH:mm:ss.SSS,UTC} &lt;${logbackService:-${logbackServiceName}}:%thread:${PID:- }&gt; %X{userid:-} %-5level \(%logger{15}\) %msg%n"/>

    <turboFilter class="org.zowe.apiml.product.logging.InfinispanLogsFilter"/>
    <turboFilter class="org.zowe.apiml.product.logging.UseridFilter"/>

    <!-- This filter needs to run before log hiders, otherwise OTEL won't get any logs. -->
    <turboFilter class="org.zowe.apiml.product.logging.OpenTelemetryLogsFilter"/>

    <springProfile name="!debug &amp; !diag &amp; !dev">
        <turboFilter class="org.zowe.apiml.product.logging.ApimlDebugGateFilter"/>
        <turboFilter class="org.zowe.apiml.product.logging.ApimlDependencyLogHider"/>
        <turboFilter class="org.zowe.apiml.product.logging.LogLevelInfoFilter"/>
        <turboFilter class="org.zowe.apiml.product.logging.ApimlDuplicateMessagesFilter">
            <AllowedRepetitions>0</AllowedRepetitions>
            <cacheSize>3000</cacheSize>
        </turboFilter>
    </springProfile>

    <conversionRule conversionWord="clr" class="org.springframework.boot.logging.logback.ColorConverter"/>

    <condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
        <key>DEBUG_ONLY_TO_FILE</key>
        <value>true</value>
    </condition>
    <if>
        <then>
            <!-- Debug (and lower) level messages are written to the log file only, stdout is limited to INFO and above -->
            <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
                <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                    <level>INFO</level>
                </filter>
                <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
                    <layout class="org.zowe.apiml.product.logging.MaskingLogPatternLayout">
                        <pattern>${APIML_LOG_PATTERN}</pattern>
                    </layout>
                </encoder>
            </appender>
        </then>
        <else>
            <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
                <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
                    <layout class="org.zowe.apiml.product.logging.MaskingLogPatternLayout">
                        <pattern>${APIML_LOG_PATTERN}</pattern>
                    </layout>
                </encoder>
            </appender>
        </else>
    </if>

    <appender name="OpenTelemetry" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender"/>

    <condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
        <key>LOG_TO_FILE</key>
        <value>true</value>
    </condition>
    <if>
        <then>
            <appender name="FILE" class="org.zowe.apiml.product.logging.ApimlRollingFileAppender">
                <file>${STORAGE_LOCATION}/${logbackService:-${logbackServiceName}}.log</file>

                <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
                    <fileNamePattern>${STORAGE_LOCATION}/${logbackService:-${logbackServiceName}}.%i.log</fileNamePattern>
                    <minIndex>${MIN_INDEX}</minIndex>
                    <maxIndex>${MAX_INDEX}</maxIndex>
                </rollingPolicy>

                <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
                    <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
                </triggeringPolicy>

                <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
                    <layout class="org.zowe.apiml.product.logging.MaskingLogPatternLayout">
                        <pattern>${APIML_LOG_PATTERN}</pattern>
                    </layout>
                </encoder>
            </appender>
        </then>
    </if>

    <condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
        <key>LOG_TO_FILE</key>
        <value>true</value>
    </condition>
    <if>
        <then>
            <root level="ERROR">
                <appender-ref ref="STDOUT"/>
                <appender-ref ref="FILE"/>
            </root>
        </then>
        <else>
            <root level="ERROR">
                <appender-ref ref="STDOUT"/>
            </root>
        </else>
    </if>

    <logger name="org.zowe.apiml.opentelemetry" level="INFO" additivity="false">
        <appender-ref ref="OpenTelemetry" />
    </logger>
    <logger name="org.infinispan.persistence.sifs.FileProvider" level="DEBUG" />
</configuration>
