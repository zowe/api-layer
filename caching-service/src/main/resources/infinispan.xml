<infinispan
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="urn:infinispan:config:16.1 https://infinispan.org/schemas/infinispan-config-16.1.xsd"
    xmlns:jgroup="urn:org:jgroups"
    xmlns="urn:infinispan:config:16.1">
    <jgroups>
        <stack name="prod">
            <!-- jgroups.tcp.address is deprecated and will be removed, see ISPN-11867 -->
            <jgroup:TCP
                bind_addr="${jgroups.bind.address,jgroups.tcp.address:SITE_LOCAL}"
                bind_port="${jgroups.bind.port,jgroups.tcp.port:7600}"
                use_vthreads="${jgroups.thread.virtual,org.infinispan.threads.virtual:true}"
                thread_naming_pattern="pl"
                send_buf_size="640k"
                sock_conn_timeout="5000"
                bundler_type="no-bundler"

                thread_pool.min_threads="${jgroups.thread_pool.min_threads:0}"
                thread_pool.max_threads="${jgroups.thread_pool.max_threads:200}"
                thread_pool.keep_alive_time="60000"
                diag.enabled="${jgroups.tcp.diag.enabled:false}"
            />
            <jgroup:TCPPING
                initial_hosts="${jgroups.tcpping.initial_hosts}"
                port_range="0"
                num_discovery_runs="${jgroups.tcpping.num_discovery_runs}"
            />
            <jgroup:MERGE3
                min_interval="10000"
                max_interval="30000"
            />

            <!-- Suspect node `timeout` to `timeout + timeout_check_interval` millis after the last heartbeat -->
            <jgroup:FD_ALL
                timeout="10000"
                interval="2000"
                timeout_check_interval="1000"
            />
            <jgroup:VERIFY_SUSPECT
                timeout="1000"/>
            <jgroup:SSL_KEY_EXCHANGE
                keystore_name="${infinispan.ssl.keyStore}"
                keystore_type="${infinispan.ssl.keyStoreType}"
                keystore_password="${infinispan.ssl.keyStorePassword}"
                truststore_name="${infinispan.ssl.trustStore}"
                truststore_type="${infinispan.ssl.trustStoreType}"
                truststore_password="${infinispan.ssl.trustStorePassword}"
                secret_key_algorithm="AES"
                port="${jgroups.keyExchange.port}"
                port_range="0"
                socket_timeout="${jgroups.keyExchange.socketTimeout:5000}"
                require_client_authentication="false"
            />
            <!-- Configures ASYM_ENCRYPT -->
            <!-- The use_external_key_exchange = "true" attribute configures nodes to use the `SSL_KEY_EXCHANGE. -->
            <jgroup:ASYM_ENCRYPT
                asym_keylength="2048"
                asym_algorithm="RSA"
                change_key_on_coord_leave="true"
                change_key_on_leave="true"
                use_external_key_exchange="true"
                sym_keylength="128"
                sym_algorithm="AES/CBC/PKCS5Padding"
                sym_iv_length="16"
            />

            <jgroup:pbcast.NAKACK2 />

            <jgroup:UNICAST3
                xmit_interval="100"
                xmit_table_num_rows="50"
                xmit_table_msgs_per_row="1024"
                xmit_table_max_compaction_time="30000"
            />
            <jgroup:pbcast.STABLE
                desired_avg_gossip="5000"
                max_bytes="1M"
            />
            <jgroup:pbcast.GMS
                print_local_addr="false"
                join_timeout="30000"
                max_join_attempts="0"
            />
            <jgroup:UFC
                max_credits="4m"
                min_threshold="0.40"
            />
            <jgroup:MFC
                max_credits="4m"
                min_threshold="0.40"
            />
            <jgroup:FRAG3 />
        </stack>
    </jgroups>
    <cache-container name="default" statistics="true">
        <!-- Configures the cluster to use the JGroups stack. -->
        <transport
            cluster="zowe-cluster"
            stack="prod"
            node-name="${infinispan.node.name:}"
        />

        <serialization marshaller="org.infinispan.jboss.marshalling.commons.GenericJBossMarshaller">
            <allow-list>
                <regex>org.zowe.apiml.caching.*</regex>
                <regex>org.zowe.apiml.security.common.token.*</regex>
                <regex>com.nimbusds.jwt.*</regex>
                <regex>com.nimbusds.jose.*</regex>
                <regex>java.util.*</regex>
                <regex>java.security.cert.*</regex>
            </allow-list>
        </serialization>

    </cache-container>
</infinispan>
