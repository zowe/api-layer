<infinispan
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="urn:infinispan:config:15.0 https://infinispan.org/schemas/infinispan-config-15.2.xsd
                        urn:infinispan:server:15.0 https://infinispan.org/schemas/infinispan-server-15.2.xsd
                        urn:org:jgroups http://www.jgroups.org/schema/jgroups-5.4.xsd"
    xmlns="urn:infinispan:config:15.2">
    <jgroups>
        <stack name="prod">
            <!-- jgroups.tcp.address is deprecated and will be removed, see ISPN-11867 -->
            <TCP bind_addr="${jgroups.bind.address,jgroups.tcp.address:SITE_LOCAL}"
                 bind_port="${jgroups.bind.port,jgroups.tcp.port:7600}"

                 thread_naming_pattern="pl"
                 send_buf_size="640k"
                 sock_conn_timeout="300"
                 bundler_type="no-bundler"

                 thread_pool.min_threads="${jgroups.thread_pool.min_threads:0}"
                 thread_pool.max_threads="${jgroups.thread_pool.max_threads:200}"
                 thread_pool.keep_alive_time="60000"
                 diag.enabled="${jgroups.tcp.diag.enabled:false}"
            />
            <TCPPING initial_hosts="${jgroups.tcpping.initial_hosts}"
                     port_range="0"
            />
            <MERGE3 min_interval="10000"
                    max_interval="30000"
            />

            <!-- Suspect node `timeout` to `timeout + timeout_check_interval` millis after the last heartbeat -->
            <FD_ALL timeout="10000"
                    interval="2000"
                    timeout_check_interval="1000"
            />
            <VERIFY_SUSPECT timeout="1000"/>

            <pbcast.NAKACK2/>

            <UNICAST3 xmit_interval="100"
                      xmit_table_num_rows="50"
                      xmit_table_msgs_per_row="1024"
                      xmit_table_max_compaction_time="30000"
            />
            <pbcast.STABLE desired_avg_gossip="5000"
                           max_bytes="1M"
            />
            <pbcast.GMS print_local_addr="true"
                        join_timeout="${jgroups.join_timeout:2000}"
                        max_join_attempts="0"
            />
            <UFC max_credits="4m"
                 min_threshold="0.40"
            />
            <MFC max_credits="4m"
                 min_threshold="0.40"
            />
            <FRAG3/>
        </stack>
    </jgroups>
    <cache-container name="default" statistics="true">
        <!-- Configures the cluster to use the JGroups stack. -->
        <transport cluster="zowe-cluster"
                   stack="prod"
                   node-name="${infinispan.node.name:}"/>

        <serialization marshaller="org.infinispan.jboss.marshalling.commons.GenericJBossMarshaller">
            <allow-list>
                <class>org.zowe.apiml.caching.model.KeyValue</class>
                <class>org.zowe.apiml.security.common.token.TokenAuthentication</class>
                <class>org.zowe.apiml.security.common.token.TokenAuthentication$Type</class>
                <class>java.util.HashMap</class>
                <class>java.util.Arrays$ArrayList</class>
                <class>java.security.cert.Certificate$CertificateRep</class>
            </allow-list>
        </serialization>

    </cache-container>
</infinispan>
