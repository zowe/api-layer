#
# Negative test: unknown certificate authority.
#
# Signed by the negative CA, which is absent from the default truststore. Used by
# common-service-core TomcatHttpsTest to assert that a chain rooted in an unknown
# CA is rejected, and that it is accepted once certificate validation is
# explicitly disabled.
#
# Generated by keystore/generate-certificates.sh
#

[ req ]
default_bits            = 2048
prompt                  = no
default_md              = sha256
distinguished_name      = dn
req_extensions          = v3_req

[ v3_req ]
keyUsage                = critical, digitalSignature, keyEncipherment
extendedKeyUsage        = clientAuth, serverAuth
subjectKeyIdentifier    = hash
subjectAltName          = @alt_names

[ dn ]
C                       = "CZ"
ST                      = "Prague"
L                       = "Prague"
O                       = "Zowe Sample"
OU                      = "API Mediation Layer"
CN                      = "Zowe Service 2"

[ alt_names ]
DNS.1 = localhost
DNS.2 = localhost.localdomain
IP.1  = 127.0.0.1
