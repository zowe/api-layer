#
# Negative test: hostname mismatch.
#
# A fully valid certificate signed by the PRIMARY CA whose subject and SANs do
# not cover localhost. The chain must validate so that the only thing that fails
# is hostname verification - gateway-service WebSocketTest relies on this to
# prove the non-strict hostname restriction works. Signing this with the
# negative CA instead would make those tests fail for the wrong reason.
#
# Deliberately has no subjectAltName, so verification falls back to the CN.
#
# Generated by keystore/generate-certificates.sh
#

[ req ]
default_bits            = 2048
prompt                  = no
default_md              = sha256
distinguished_name      = dn
req_extensions          = v3_req

[ v3_req ]
keyUsage                = critical, digitalSignature, keyEncipherment
extendedKeyUsage        = clientAuth, serverAuth
subjectKeyIdentifier    = hash

[ dn ]
C                       = "CZ"
ST                      = "Czechia"
L                       = "Prague"
O                       = "Broadcom"
OU                      = "MSD"
CN                      = "nonlocalhost.local"
