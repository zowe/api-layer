#
# Negative test: self-signed certificate.
#
# No issuer at all - not merely an untrusted CA. Used by certificate-analyser
# LocalHandshakeTest to check that the analyser reports a self-signed server
# certificate rather than a broken chain.
#
# Generated by keystore/generate-certificates.sh
#

[ req ]
default_bits            = 2048
prompt                  = no
default_md              = sha256
distinguished_name      = dn
x509_extensions         = v3_req

[ v3_req ]
keyUsage                = critical, digitalSignature, keyEncipherment
extendedKeyUsage        = clientAuth, serverAuth
subjectKeyIdentifier    = hash
subjectAltName          = @alt_names

[ dn ]
C                       = "CZ"
ST                      = "Prague"
L                       = "Prague"
O                       = "Zowe Sample"
OU                      = "API Mediation Layer"
CN                      = "Zowe Service"

[ alt_names ]
DNS.1 = localhost
DNS.2 = localhost.localdomain
IP.1  = 127.0.0.1
