#
# Untrusted certificate authority, for negative tests only.
#
# Deliberately absent from every truststore except
# negative/untrusted-ca.truststore.p12. Used to produce a certificate chain that
# must fail path validation, so that tests asserting "a certificate from an
# unknown authority is rejected" fail for the right reason.
#
# Generated by keystore/generate-certificates.sh
#

[ req ]
default_bits            = 2048
prompt                  = no
default_md              = sha256
distinguished_name      = dn
x509_extensions         = v3_ca

[ v3_ca ]
basicConstraints        = critical, CA:TRUE
keyUsage                = critical, keyCertSign, cRLSign
subjectKeyIdentifier    = hash

[ dn ]
C                       = "CZ"
ST                      = "Prague"
L                       = "Prague"
O                       = "Zowe Sample"
OU                      = "API Mediation Layer"
CN                      = "Zowe Development Untrusted Certificate Authority"
