#
# Client certificate authority.
#
# Signs only the user certificates used to test client-certificate
# authentication (APIMTST, USER, UNKNOWNUSER).
#
# Kept separate from the service CA because in a real deployment the
# certificates presented as user identities come from a different PKI - a
# corporate CA or a mainframe-issued certificate - than the one that minted the
# service keypairs. Keeping two authorities means the fixtures exercise a
# multi-anchor truststore, so code cannot quietly assume that a client
# certificate shares an issuer with the service certificate.
#
# Note that both authorities are present in service/service.truststore.p12, so
# this split does not by itself restrict what API ML trusts.
#
# Generated by keystore/generate-certificates.sh
#

[ req ]
default_bits            = 2048
prompt                  = no
default_md              = sha256
distinguished_name      = dn
x509_extensions         = v3_ca

[ v3_ca ]
basicConstraints        = critical, CA:TRUE
keyUsage                = critical, keyCertSign, cRLSign
subjectKeyIdentifier    = hash

[ dn ]
C                       = "CZ"
ST                      = "Czechia"
L                       = "Prague"
O                       = "OMF"
OU                      = "Zowe"
CN                      = "Zowe Development Client Certificate Authority"
