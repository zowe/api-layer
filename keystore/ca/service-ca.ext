#
# Service certificate authority.
#
# Signs every identity API ML presents: the service certificate, the
# serverAuth-only and clientAuth-only split-role certificates, and the
# hostname-mismatch negative certificate. Its public certificate is the only
# entry a service needs in its truststore to talk to another API ML service.
#
# Generated by keystore/generate-certificates.sh
#

[ req ]
default_bits            = 2048
prompt                  = no
default_md              = sha256
distinguished_name      = dn
x509_extensions         = v3_ca

[ v3_ca ]
basicConstraints        = critical, CA:TRUE
keyUsage                = critical, keyCertSign, cRLSign
subjectKeyIdentifier    = hash

[ dn ]
C                       = "CZ"
ST                      = "Prague"
L                       = "Prague"
O                       = "Zowe Sample"
OU                      = "API Mediation Layer"
CN                      = "Zowe Development Service Certificate Authority"
