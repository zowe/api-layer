#
# Container profile: outbound (client) identity.
#
# clientAuth only, and deliberately without any subject alternative name - this
# certificate identifies a service acting as a client, never a listener. Paired
# with server-only.ext. Chains to the primary CA.
#
# Generated by keystore/generate-certificates.sh
#

[ req ]
default_bits            = 2048
prompt                  = no
default_md              = sha256
distinguished_name      = dn
req_extensions          = v3_req

[ v3_req ]
keyUsage                = critical, digitalSignature, keyEncipherment
extendedKeyUsage        = clientAuth
subjectKeyIdentifier    = hash

[ dn ]
C                       = "CZ"
ST                      = "Czechia"
L                       = "Prague"
O                       = "OMP"
OU                      = "API Mediation Layer"
CN                      = "Zowe Component Client"
