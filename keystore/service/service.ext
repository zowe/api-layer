#
# The single API ML server identity.
#
# One certificate covering every hostname API ML is reached by in any profile:
# plain localhost, the multi-instance local profile (localhost2 / localhost3) and
# every container hostname. Keeping the SAN list here as a union means no profile
# needs a certificate of its own.
#
# 127.0.0.1 is an IP SAN, not a DNS one - no TLS stack matches a DNS SAN against a
# connection to a literal address.
#
# Generated by keystore/generate-certificates.sh
#

[ req ]
default_bits            = 2048
prompt                  = no
default_md              = sha256
distinguished_name      = dn
req_extensions          = v3_req

[ v3_req ]
keyUsage                = critical, digitalSignature, keyEncipherment
extendedKeyUsage        = clientAuth, serverAuth
subjectKeyIdentifier    = hash
subjectAltName          = @alt_names

[ dn ]
C                       = "CZ"
ST                      = "Prague"
L                       = "Prague"
O                       = "Zowe Sample"
OU                      = "API Mediation Layer"
# Asserted on by config/local/gateway-service.yml (x509.registry.allowedUsers)
# and apiml-security-common TrustedCertificatesProviderTest. Do not change.
CN                      = "Zowe Service"

[ alt_names ]
DNS.1  = localhost
DNS.2  = localhost.localdomain
DNS.3  = localhost2
DNS.4  = localhost3
DNS.5  = zaas-service
DNS.6  = zaas-service-2
DNS.7  = api-catalog-services
DNS.8  = api-catalog-services-2
DNS.9  = caching-service
DNS.10 = caching-service-2
DNS.11 = caching-service-3
DNS.12 = discovery-service
DNS.13 = discovery-service-2
DNS.14 = discoverable-client
DNS.15 = discoverable-client-1
DNS.16 = discoverable-client-2
DNS.17 = discoverable-client-3
DNS.18 = discoverable-client-4
DNS.19 = discoverable-client-unknown
DNS.20 = mock-services
DNS.21 = mock-services-2
DNS.22 = mock-services-unknown
DNS.23 = reverse-proxy
DNS.24 = gateway-service
DNS.25 = gateway-service-2
DNS.26 = central-gateway-service
DNS.27 = central-gateway-service-2
DNS.28 = apiml
DNS.29 = apiml-2
DNS.30 = apiml-3
DNS.31 = nodejs-sample-app
DNS.32 = python-sample-app
IP.1   = 127.0.0.1
