#
# The single API ML server identity.
#
# One certificate covering every hostname API ML is reached by in any profile:
# plain localhost, the multi-instance local profile (localhost2) and
# every container hostname. Keeping the SAN list here as a union means no profile
# needs a certificate of its own.
#
# 127.0.0.1 is an IP SAN, not a DNS one - no TLS stack matches a DNS SAN against a
# connection to a literal address.
#
# Generated by keystore/generate-certificates.sh
#

[ req ]
default_bits            = 2048
prompt                  = no
default_md              = sha256
distinguished_name      = dn
req_extensions          = v3_req

[ v3_req ]
keyUsage                = critical, digitalSignature, keyEncipherment
extendedKeyUsage        = clientAuth, serverAuth
subjectKeyIdentifier    = hash
subjectAltName          = @alt_names

[ dn ]
C                       = "CZ"
ST                      = "Prague"
L                       = "Prague"
O                       = "Zowe Sample"
OU                      = "API Mediation Layer"
# Asserted on by config/local/gateway-service.yml (x509.registry.allowedUsers)
# and apiml-security-common TrustedCertificatesProviderTest. Do not change.
CN                      = "Zowe Service"

[ alt_names ]
DNS.1  = localhost
DNS.2  = localhost.localdomain
DNS.3  = localhost2
DNS.4  = api-catalog-services
DNS.5  = api-catalog-services-2
DNS.6  = caching-service
DNS.7  = caching-service-2
DNS.8  = discovery-service
DNS.9  = discovery-service-2
DNS.10 = discoverable-client
DNS.11 = discoverable-client-1
DNS.12 = discoverable-client-2
DNS.13 = discoverable-client-3
DNS.14 = discoverable-client-4
DNS.15 = mock-services
DNS.16 = mock-services-2
DNS.17 = metrics-service
DNS.18 = metrics-service-2
DNS.19 = reverse-proxy
DNS.20 = gateway-service
DNS.21 = gateway-service-2
DNS.22 = cloud-gateway-service
DNS.23 = cloud-gateway-service-2
IP.1   = 127.0.0.1
