#
# Container profile: inbound (server) identity.
#
# serverAuth only. Paired with client-cert.ext so that config/docker/*.yml
# exercises a listener whose certificate cannot be replayed as a client
# identity. Chains to the primary CA.
#
# Generated by keystore/generate-certificates.sh
#

[ req ]
default_bits            = 2048
prompt                  = no
default_md              = sha256
distinguished_name      = dn
req_extensions          = v3_req

[ v3_req ]
keyUsage                = critical, digitalSignature, keyEncipherment
extendedKeyUsage        = serverAuth
subjectKeyIdentifier    = hash
subjectAltName          = @alt_names

[ dn ]
C                       = "CZ"
ST                      = "Czechia"
L                       = "Prague"
O                       = "Zowe Sample"
OU                      = "API Mediation Layer"
CN                      = "Zowe Component"

[ alt_names ]
DNS.1  = localhost
DNS.2  = localhost.localdomain
DNS.3  = localhost2
DNS.4  = api-catalog-services
DNS.5  = api-catalog-services-2
DNS.6  = caching-service
DNS.7  = caching-service-2
DNS.8  = discovery-service
DNS.9  = discovery-service-2
DNS.10 = discoverable-client
DNS.11 = discoverable-client-1
DNS.12 = discoverable-client-2
DNS.13 = discoverable-client-3
DNS.14 = discoverable-client-4
DNS.15 = mock-services
DNS.16 = mock-services-2
DNS.17 = metrics-service
DNS.18 = metrics-service-2
DNS.19 = reverse-proxy
DNS.20 = gateway-service
DNS.21 = gateway-service-2
DNS.22 = cloud-gateway-service
DNS.23 = cloud-gateway-service-2
IP.1   = 127.0.0.1
