#
# Client certificate for user UNKNOWNUSER.
#
# A valid certificate from a trusted CA whose CN does not map to any known user,
# used to test the rejected-identity path. Listed in
# APIML_SECURITY_X509_REGISTRY_ALLOWEDUSERS in the CI workflows.
# Do not change the CN.
#
# Generated by keystore/generate-certificates.sh
#

[ req ]
default_bits            = 2048
prompt                  = no
default_md              = sha256
distinguished_name      = dn
req_extensions          = v3_req

[ v3_req ]
keyUsage                = critical, digitalSignature, keyEncipherment
extendedKeyUsage        = clientAuth
subjectKeyIdentifier    = hash
subjectAltName          = @alt_names

[ dn ]
C                       = "CZ"
ST                      = "Czechia"
L                       = "Prague"
O                       = "OMF"
OU                      = "Zowe"
CN                      = "UNKNOWNUSER"

[ alt_names ]
DNS.1 = localhost
IP.1  = 127.0.0.1
